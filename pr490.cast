[1.01511, "o", "================================================================\r\nPR #490 - feat(layout): capture the Devin Desktop session layout\r\n"]
[1.018902, "o", "Synthetic fixtures only (repo testdata + a synthetic state.vscdb)\r\n================================================================\r\n"]
[2.024562, "o", "\r\n--- BEFORE: base tip 92d67881 (PR #488 branch, no Devin Desktop) ---\r\n"]
[3.028944, "o", "$ peasant-base layout list\r\n"]
[3.120436, "o", "(no output above: no layout tools are registered at the base)\r\n"]
[4.124993, "o", "\r\n$ peasant-base layout capture devin-desktop --path fixtures/... --include-metadata\r\n"]
[4.215817, "o", "Error: unknown layout tool \"devin-desktop\" (known: [])\r\n"]
[4.229424, "o", "exit: 141  <- Devin Desktop layout is NOT captured at the base\r\n"]
[5.233102, "o", "\r\n--- AFTER: PR head c8bdc95d (rebased onto 92d67881) ---\r\n"]
[6.270051, "o", "$ peasant-head layout list\r\n"]
[6.811262, "o", "Devin Desktop (devin-desktop)\r\n  One ACP event stream per agent session, and one opaque Cascade trajectory file per legacy Cascade conversation; the shared global state database is captured once as its own entry.\r\n  root ~/.config/Devin [absent]\r\n  root ~/.codeium/windsurf [absent]\r\n  transcript jsonl    User/acp-events/*.ndjson\r\n  transcript text     cascade/*.pb\r\n  index      sqlite   User/globalStorage/state.vscdb\r\n"]
[7.845865, "o", "\r\n$ peasant-head layout capture devin-desktop --path fixtures/config/Devin \\\r\n    --path fixtures/home/.codeium/windsurf --include-metadata --limit 0\r\n"]
[8.12117, "o", "exit: 0\r\n"]
[8.248055, "o", "root fixtures/config/Devin: present=True sessions=3\r\nroot fixtures/home/.codeium/windsurf: present=True sessions=1\r\ncaptures: 4  failures: 0\r\n- session 0b1d2c3e-0000-4000-8000-00000000a001 title='Fixture widget rename' models=['fixture-model-1'] user=2 assistant=2 toolCalls=1\r\n    acp-events: format=jsonl role=transcript records=11 kinds={'agent_message_chunk': 3, 'agent_thought_chunk': 1, 'available_commands_update': 1, 'session_info_update': 1, 'tool_call': 1, 'tool_call_update': 1, 'usage_update': 1, 'user_message_chunk': 2}\r\n- session 0b1d2c3e-0000-4000-8000-00000000a002 user=1 assistant=1 toolCalls=0\r\n    acp-events: format=jsonl role=transcript records=2 kinds={'agent_message_chunk': 1, 'user_message_chunk': 1}\r\n- session User/globalStorage/state.vscdb\r\n    global-state: format=sqlite role=index records=4 kinds={'windsurf.state.cachedActiveTrajectory:*': 1, 'windsurf.state.cachedTrajectorySummaries:*': 1, 'windsurf.syntheticCount': 1, 'windsurf.syntheticFlag': 1}\r\n- session 0b1d2c3e-0000-4000-8000-00000000c001\r\n    cascade-trajectory: format=text role=transcript records=1 kinds={'opaque-under-64KiB': 1}\r\n"]
